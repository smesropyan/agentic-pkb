# Copy to `.env` (gitignored) and fill in. `chmod 600 .env` — it holds both halves of the
# Telegram deployment's security: the credential and the list of people who may use it.
#
# A real environment variable always wins over a line here, so a systemd unit or a container
# secret is never silently overridden by a stale file.

# From @BotFather: /newbot, or /token for a bot you already have.
# Revoke with /revoke if it ever reaches a log, a screenshot or a chat with an assistant.
PKB_TELEGRAM_TOKEN=123456789:AA-replace-this-with-your-own-token

# Who may say yes. Comma- or space-separated Telegram *user* ids — not chat ids, not usernames.
# Message @userinfobot to learn yours.
#
# This is the system's only authentication boundary: a bot's username is discoverable, and anyone
# who finds it is talking to a process that writes to your knowledge base with no undo. Empty or
# unset refuses everyone, which is the safe default for a half-finished deployment.
PKB_TELEGRAM_OWNERS=987654321

# The chat -> agent mapping is NOT here: it names no credential, so it lives in
# `<db>.telegram.json` beside the SQLite file and can be committed. You have exactly one private
# chat per bot, so map it to `librarian` unless you want one topic and nothing else.
#     {"chats": {"987654321": "librarian"}}
